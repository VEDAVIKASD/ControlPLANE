{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "controlplane-gateway": {
      "root": "gateway",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "console/frontend",
      "framework": "vite"
    },
    "showcase": {
      "root": "showcase",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "controlplane-gateway"
      }
    },
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "showcase"
      }
    }
  ]
}
